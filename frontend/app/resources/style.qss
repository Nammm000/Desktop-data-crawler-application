/* Data Crawler — global stylesheet (light, indigo accent) */

QWidget {
    font-family: "SF Pro Text", "Segoe UI", "Helvetica Neue", sans-serif;
    font-size: 13px;
    color: #1F2430;
}

QMainWindow,
QWidget#loginRoot,
QWidget#mainRoot,
QWidget#loadingRoot {
    background-color: #F5F6FA;
}

/* --- Inputs --------------------------------------------------------------- */

QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 12px;
    selection-background-color: #4F46E5;
    selection-color: #FFFFFF;
}
QLineEdit:focus {
    border: 1px solid #4F46E5;
}
QLineEdit:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* --- Buttons --------------------------------------------------------------- */

QPushButton {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 16px;
    font-weight: 500;
}
QPushButton:hover {
    background-color: #F3F4F6;
}
QPushButton:pressed {
    background-color: #E9EBF0;
}
QPushButton:disabled {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
    color: #9CA3AF;
}

QPushButton#primaryButton {
    background-color: #4F46E5;
    border: 1px solid #4F46E5;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#primaryButton:hover {
    background-color: #4338CA;
    border-color: #4338CA;
}
QPushButton#primaryButton:pressed {
    background-color: #3730A3;
    border-color: #3730A3;
}
QPushButton#primaryButton:disabled {
    background-color: #A5B4FC;
    border-color: #A5B4FC;
    color: #EEF2FF;
}

QPushButton#navButton {
    border: none;
    border-radius: 8px;
    background-color: transparent;
    color: #6B7280;
    padding: 0 14px;
}
QPushButton#navButton:hover {
    color: #1F2430;
    background-color: #F3F4F6;
}
QPushButton#navButton:checked {
    color: #4F46E5;
    background-color: #EEF2FF;
    font-weight: 600;
}

QPushButton#accountButton {
    color: #374151;
    font-weight: 600;
    background-color: transparent;
    border: 1px solid transparent;
}
QPushButton#accountButton:hover {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
}
QPushButton#accountButton:pressed {
    background-color: #E9EBF0;
    border-color: #E2E4EA;
}

QPushButton#notificationButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}
QPushButton#notificationButton:hover {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
}
QPushButton#notificationButton:pressed {
    background-color: #E9EBF0;
}
QPushButton#notificationButton[unread="true"] {
    background-color: #EEF2FF;
    border-color: #C7D2FE;
}
QPushButton#notificationButton[unread="true"]:hover {
    background-color: #E0E7FF;
    border-color: #C7D2FE;
}

/* --- Login card ------------------------------------------------------------ */

QFrame#loginCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 12px;
}

QFrame#segmentedHost {
    background-color: #F3F4F6;
    border-radius: 8px;
}

QFrame#dashboardCard,
QFrame#settingsCard,
QFrame#dialogCard {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 12px;
}

QDialog#changePasswordDialog,
QDialog#confirmDialog,
QDialog#agentDialog {
    background-color: #F5F6FA;
}

QScrollArea#loginScroll {
    background: transparent;
    border: none;
}

QWidget#loginScrollContent {
    background: transparent;
}
QPushButton#modeToggle {
    background-color: transparent;
    border: none;
    border-radius: 6px;
    color: #6B7280;
}
QPushButton#modeToggle:hover {
    color: #1F2430;
}
QPushButton#modeToggle:checked {
    background-color: #FFFFFF;
    color: #1F2430;
    font-weight: 600;
}

/* --- Header ---------------------------------------------------------------- */

QFrame#header {
    background-color: #FFFFFF;
    border: none;
    border-bottom: 1px solid #E2E4EA;
}

QMenu#accountMenu,
QMenu#notificationMenu {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 8px;
    padding: 4px;
}
QMenu#accountMenu::item,
QMenu#notificationMenu::item {
    border-radius: 6px;
    padding: 6px 24px 6px 12px;
    color: #1F2430;
}
QMenu#accountMenu::item:selected,
QMenu#notificationMenu::item:selected {
    background-color: #EEF2FF;
    color: #4F46E5;
}
QMenu#accountMenu::item:disabled {
    color: #9CA3AF;
}
QMenu#notificationMenu::item:disabled {
    color: #4B5563;  /* entries are informational text, not grayed-out actions */
}

/* --- Management tables (users, agents) --------------------------------------- */

QTableWidget#usersTable,
QTableWidget#agentsTable {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 12px;
    gridline-color: #F0F1F5;
    alternate-background-color: #FAFAFC;
}
QHeaderView#usersTableHeader::section,
QHeaderView#agentsTableHeader::section {
    background-color: #F9FAFC;
    border: none;
    border-bottom: 1px solid #E2E4EA;
    border-radius: 0;
    padding: 8px 12px;
    font-weight: 600;
    color: #4B5563;
}

QComboBox#limitSelector,
QComboBox#roleCombo,
QComboBox#statusCombo {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 6px;
    min-height: 28px;
    padding: 0 10px;
}
QComboBox#limitSelector:disabled,
QComboBox#roleCombo:disabled,
QComboBox#statusCombo:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}
QComboBox#limitSelector::drop-down,
QComboBox#roleCombo::drop-down,
QComboBox#statusCombo::drop-down {
    border: none;
    background: transparent;
    width: 22px;
}
QComboBox#limitSelector::down-arrow,
QComboBox#roleCombo::down-arrow,
QComboBox#statusCombo::down-arrow {
    image: url(%icons%/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox#limitSelector QAbstractItemView,
QComboBox#roleCombo QAbstractItemView,
QComboBox#statusCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    color: #1F2430;
    selection-background-color: #EEF2FF;
    selection-color: #1F2430;
    outline: none;
}
QComboBox#limitSelector QAbstractItemView::item,
QComboBox#roleCombo QAbstractItemView::item,
QComboBox#statusCombo QAbstractItemView::item {
    background-color: transparent;
}
QComboBox#limitSelector QAbstractItemView::item:selected,
QComboBox#roleCombo QAbstractItemView::item:selected,
QComboBox#statusCombo QAbstractItemView::item:selected,
QComboBox#limitSelector QAbstractItemView::item:hover,
QComboBox#roleCombo QAbstractItemView::item:hover,
QComboBox#statusCombo QAbstractItemView::item:hover {
    background-color: #EEF2FF;
}

QPushButton#pageButton {
    min-height: 30px;
    padding: 0 12px;
}

QCheckBox#rowCheckBox,
QCheckBox#selectAllCheckBox {
    background: transparent;
    spacing: 8px;
}
QCheckBox#selectAllCheckBox {
    color: #4B5563;
    font-size: 12px;
    font-weight: 600;
}
QCheckBox#rowCheckBox::indicator,
QCheckBox#selectAllCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #E2E4EA;
    border-radius: 4px;
    background-color: #FFFFFF;
}
QCheckBox#rowCheckBox:hover::indicator,
QCheckBox#selectAllCheckBox:hover::indicator {
    border-color: #4F46E5;
}
QCheckBox#rowCheckBox::indicator:checked,
QCheckBox#selectAllCheckBox::indicator:checked {
    background-color: #4F46E5;
    border-color: #4F46E5;
    image: url(%icons%/check.svg);
}
QCheckBox#rowCheckBox::indicator:disabled,
QCheckBox#selectAllCheckBox::indicator:disabled {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
}

QPushButton#rowDeleteButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}
QPushButton#rowDeleteButton:hover {
    background-color: #FEF2F2;
    border-color: #FECACA;
}
QPushButton#rowDeleteButton:pressed {
    background-color: #FEE2E2;
}

QPushButton#dangerButton {
    background-color: #DC2626;
    border: 1px solid #DC2626;
    color: #FFFFFF;
    font-weight: 600;
}
QPushButton#dangerButton:hover {
    background-color: #B91C1C;
    border-color: #B91C1C;
}
QPushButton#dangerButton:pressed {
    background-color: #991B1B;
    border-color: #991B1B;
}
QPushButton#dangerButton:disabled {
    background-color: #FCA5A5;
    border-color: #FCA5A5;
    color: #FEF2F2;
}

/* --- Agent management ------------------------------------------------------ */

QPushButton#rowEditButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0;
}
QPushButton#rowEditButton:hover {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
}
QPushButton#rowEditButton:pressed {
    background-color: #E9EBF0;
}

/* Dialog-form metrics (sits between 36px QLineEdit fields, so it must not
   use the 28px table-combo metrics above). */
QComboBox#formatCombo {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    border-radius: 8px;
    min-height: 36px;
    padding: 0 12px;
}
QComboBox#formatCombo:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}
QComboBox#formatCombo::drop-down {
    border: none;
    background: transparent;
    width: 22px;
}
QComboBox#formatCombo::down-arrow {
    image: url(%icons%/chevron-down.svg);
    width: 12px;
    height: 12px;
}
QComboBox#formatCombo QAbstractItemView {
    background-color: #FFFFFF;
    border: 1px solid #E2E4EA;
    color: #1F2430;
    selection-background-color: #EEF2FF;
    selection-color: #1F2430;
    outline: none;
}
QComboBox#formatCombo QAbstractItemView::item {
    background-color: transparent;
}
QComboBox#formatCombo QAbstractItemView::item:selected,
QComboBox#formatCombo QAbstractItemView::item:hover {
    background-color: #EEF2FF;
}

QPlainTextEdit#scriptEdit {
    background-color: #F3F4F6;
    color: #000000;
    border: 1px solid #E2E4EA;
    border-radius: 8px;
    min-height: 200px;
    padding: 8px 12px;
    font-family: "SF Mono", "Cascadia Mono", "Menlo", "Consolas", monospace;
    font-size: 12px;
}
QPlainTextEdit#scriptEdit:focus {
    border: 1px solid #4F46E5;
}
QPlainTextEdit#scriptEdit:disabled {
    background-color: #F3F4F6;
    color: #9CA3AF;
}

/* JSON key-value rows (AgentDialog json mode). Buttons are fixed 24px: the
   caption grid above the rows mirrors these columns (same stretches, spacing
   and minimums) so "key"/"value" stay aligned over their columns. */
QPushButton#addRowButton,
QPushButton#removeRowButton {
    background-color: transparent;
    border: 1px solid transparent;
    border-radius: 6px;
    min-width: 24px;
    max-width: 24px;
    min-height: 24px;
    max-height: 24px;
    padding: 0;
}
QPushButton#addRowButton:hover {
    background-color: #F3F4F6;
    border-color: #E2E4EA;
}
QPushButton#addRowButton:pressed {
    background-color: #E9EBF0;
}
QPushButton#removeRowButton:hover {
    background-color: #FEF2F2;
    border-color: #FECACA;
}
QPushButton#removeRowButton:pressed {
    background-color: #FEE2E2;
}

QScrollArea#kvRowsScroll {
    background: transparent;
    border: none;
}
QWidget#kvRowsHost {
    background: transparent;
}

/* --- Labels ----------------------------------------------------------------- */

QLabel#appTitle {
    font-size: 24px;
    font-weight: 700;
}
QLabel#cardTitle {
    font-size: 20px;
    font-weight: 700;
}
QLabel#cardSubtitle {
    color: #6B7280;
}
QLabel#fieldCaption {
    font-size: 12px;
    font-weight: 600;
    color: #4B5563;
}
QLabel#columnCaption {
    font-size: 12px;
    font-weight: 500;
    color: #9CA3AF;
}
QLabel#pageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #374151;
}
QLabel#pageSubtitle {
    color: #6B7280;
}
QLabel#pageIndicator {
    color: #6B7280;
}
QLabel#profileValue {
    font-weight: 500;
}

QLabel#errorBanner {
    background-color: #FEF2F2;
    color: #DC2626;
    border: 1px solid #FECACA;
    border-radius: 8px;
    padding: 10px 12px;
}
QLabel#warningBanner {
    background-color: #FFFBEB;
    color: #B45309;
    border: 1px solid #FDE68A;
    border-radius: 8px;
    padding: 10px 12px;
}
QLabel#successBanner {
    background-color: #ECFDF5;
    color: #047857;
    border: 1px solid #A7F3D0;
    border-radius: 8px;
    padding: 10px 12px;
}

/* --- Progress ---------------------------------------------------------------- */

QProgressBar {
    background-color: #E5E7EB;
    border: none;
    border-radius: 4px;
    min-height: 8px;
    max-height: 8px;
}
QProgressBar::chunk {
    background-color: #4F46E5;
    border-radius: 4px;
}
