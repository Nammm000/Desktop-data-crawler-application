# MongoDB (must match docker-compose.yml)
MONGODB_URI=mongodb://crawler:crawlerpass@localhost:27017/data_crawler?authSource=admin
MONGODB_DB=data_crawler

# JWT — generate a secret with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
BCRYPT_ROUNDS=12

# Comma-separated list of allowed CORS origins (frontend dev servers)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Notification push interval in seconds (default 900 = 15 minutes;
# shorten it, e.g. 3, when testing the WebSocket stream)
NOTIFICATION_INTERVAL_SECONDS=900

# Crawl safety valves: hard timeout (seconds) and page cap per agent run
CRAWL_TIMEOUT_SECONDS=600
CRAWL_MAX_PAGES=200

# Fernet key encrypting stored agent cookies/proxies (Facebook agents).
# Blank/placeholder disables credential storage. Generate with:
#   python3 -c "import base64,secrets; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
CREDENTIALS_ENCRYPTION_KEY=CHANGE_ME

# Facebook crawl pacing: seconds between requests (delayed + randomized,
# one concurrent request) — keep gentle to avoid checkpoints.
FACEBOOK_DOWNLOAD_DELAY=3
FACEBOOK_HOST=mbasic.facebook.com

# source_pages agents: randomized delay bounds (seconds) between listing-page
# navigations / load-more clicks; overall run timeout in seconds (discovery +
# article crawl — the listing delays make this longer than CRAWL_TIMEOUT);
# per-article download delay. Requires a one-time browser install:
#   .venv/bin/playwright install chromium
SOURCE_PAGES_DELAY_MIN_SECONDS=3
SOURCE_PAGES_DELAY_MAX_SECONDS=120
SOURCE_PAGES_TIMEOUT_SECONDS=3600
SOURCE_PAGES_ARTICLE_DOWNLOAD_DELAY=1

# ecommerce agents: per-request download delay (randomized), concurrent
# requests per domain, and the hard ceiling on unique products per run (a
# script's max_products may set a lower value, never higher). Static-HTML
# shops only — no browser install needed.
ECOMMERCE_DOWNLOAD_DELAY=1
ECOMMERCE_CONCURRENT_REQUESTS=2
ECOMMERCE_MAX_PRODUCTS=100
